# Environment Variables

# Connect to your free PostgreSQL instance (Neon.tech / Supabase / Local PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/attendance_crm?schema=public"

# NextAuth / JWT Secret Key (Can be any random string)
AUTH_SECRET="attendance_crm_super_secret_jwt_key_2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google Sheets Backup Sync Credentials (can be configured in Admin UI later)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
