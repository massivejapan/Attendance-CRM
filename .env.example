# Environment Variables for Production (Vercel & Supabase)

# 1. Supabase Connection Pooler URL (Transaction Mode on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Direct Connection URL (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# 3. NextAuth / JWT Secret Key (Any secure random string)
AUTH_SECRET="mjli_super_secret_jwt_attendance_crm_2026"

# 4. App URL (Optional in production)
NEXT_PUBLIC_APP_URL="https://attendance-crm.vercel.app"

# 5. Optional: Google Sheets Backup Sync Credentials (can be configured later)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
